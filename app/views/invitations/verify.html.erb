<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>Tourist Verification — Fortuna Travel</title>
  <style>
    :root { --accent: #9d1c1c; --ink: #1a1a1a; --muted: #6b7280; --line: #e5e7eb; }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
      background: #f3f4f6;
      color: var(--ink);
      line-height: 1.5;
      padding: 16px;
    }
    .card {
      max-width: 520px;
      margin: 24px auto;
      background: #fff;
      border-radius: 16px;
      box-shadow: 0 6px 24px rgba(0,0,0,.08);
      overflow: hidden;
    }
    .head {
      padding: 24px 24px 16px;
      text-align: center;
      border-bottom: 1px solid var(--line);
    }
    .head img { height: 56px; margin-bottom: 10px; }
    .head .title { font-size: 20px; font-weight: 700; color: var(--accent); }
    .head .sub { font-size: 13px; color: var(--muted); margin-top: 2px; }
    .badge {
      display: inline-block;
      margin-top: 12px;
      padding: 5px 14px;
      font-size: 13px;
      font-weight: 600;
      color: #065f46;
      background: #d1fae5;
      border-radius: 999px;
    }
    .rows { padding: 8px 24px 4px; }
    .row {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      padding: 14px 0;
      border-bottom: 1px solid var(--line);
    }
    .row:last-child { border-bottom: none; }
    .row .label { color: var(--muted); font-size: 13px; }
    .row .value { font-weight: 600; text-align: right; }
    .note {
      padding: 18px 24px 26px;
      font-size: 13px;
      color: var(--muted);
    }
    .note a { color: var(--accent); font-weight: 600; text-decoration: none; }
  </style>
</head>
<body>
  <div class="card">
    <div class="head">
<!--      <img src="<%#= image_path('fortuna_logo.png') %>" alt="Fortuna Travel">-->
      <div class="title">Tourist Verification</div>
      <div class="sub">Fortuna travel LLC</div>
      <div class="badge">✓ Verified invitation</div>
    </div>

    <div class="rows">
      <div class="row">
        <span class="label">Tourist</span>
        <span class="value"><%= @invitation.full_name %></span>
      </div>
      <div class="row">
        <span class="label">Citizenship</span>
        <span class="value"><%= @invitation.citizenship_title || @invitation.citizenship %></span>
      </div>
      <div class="row">
        <span class="label">Arrival date</span>
        <span class="value"><%= @invitation.arival_date %></span>
      </div>
      <div class="row">
        <span class="label">Departure date</span>
        <span class="value"><%= @invitation.departure_date %></span>
      </div>
    </div>

<!--    <div class="note">-->
<!--      If you have any questions about the verification results or need to clarify-->
<!--      the tourist details provided, please contact us at-->
<!--      <a href="mailto:manager.fortunatravel@gmail.com">manager.fortunatravel@gmail.com</a>-->
<!--    </div>-->
  </div>
</body>
</html>
