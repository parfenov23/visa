<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"
       style="margin-top:16px; background:#f9fafb; border:1px solid #eef0f4; border-radius:10px;">
  <% service_request.summary_lines.each do |label, value| %>
  <tr>
    <td style="padding:8px 12px; font-size:13px; color:#6b7280; width:40%; vertical-align:top;"><%= label %></td>
    <td style="padding:8px 12px; font-size:14px; color:#111827; vertical-align:top;"><%= value %></td>
  </tr>
  <% end %>
</table>
