<%# Выпадающий список гостиниц из базы + JS-подстановка в поля hotels / hotels_ru и города в cities. %>
<% hotels = (defined?(Hotel) && Hotel.table_exists?) ? Hotel.picker_options : [] %>

<datalist id="hotels_datalist">
  <% hotels.each do |h| %>
    <option value="<%= h[:label] %>"></option>
  <% end %>
</datalist>

<script type="application/json" id="hotels_data"><%= raw hotels.to_json.gsub("</") { "<\\/" } %></script>

<script>
  (function () {
    function init() {
      var picker = document.getElementById('hotel_picker_input');
      var dataEl = document.getElementById('hotels_data');
      if (!picker || !dataEl) return;

      var hotels;
      try { hotels = JSON.parse(dataEl.textContent) || []; } catch (e) { hotels = []; }

      // Добавляет строку в конец поля новой строчкой; дубликаты пропускает.
      function appendLine(field, line) {
        if (!field || !line) return;
        var lines = field.value.split('\n').map(function (s) { return s.trim(); });
        if (lines.indexOf(line.trim()) !== -1) return;
        var current = field.value.replace(/\s+$/, '');
        field.value = current ? current + '\n' + line : line;
      }

      // Заглушки, которые клиент пишет в поле городов, когда маршрут не решён.
      var CITY_PLACEHOLDERS = ['not decided', 'not decided yet', 'undecided', '-', '—'];

      // Дописывает город в поле Cities через запятую (в PDF: «Russia: Moscow, Saint Petersburg»).
      // Дубликаты без учёта регистра пропускает, заглушку «NOT DECIDED» заменяет.
      function appendCity(field, city) {
        if (!field || !city) return;
        var cities = field.value.split(/[,\n]+/)
          .map(function (s) { return s.trim(); })
          .filter(function (s) { return s && CITY_PLACEHOLDERS.indexOf(s.toLowerCase()) === -1; });
        var exists = cities.some(function (c) { return c.toLowerCase() === city.toLowerCase(); });
        if (!exists) cities.push(city);
        field.value = cities.join(', ');
      }

      function apply() {
        var val = picker.value.trim();
        if (!val) return;
        var match = hotels.find(function (h) { return h.label === val; });
        if (!match) return;

        appendLine(document.getElementById('invitation_hotels'), match.en || '');
        appendLine(document.getElementById('invitation_hotels_ru'), match.ru || match.en || '');
        appendCity(document.getElementById('invitation_cities'), (match.city || '').trim());
        // Очищаем поиск, чтобы сразу можно было выбрать следующую гостиницу.
        picker.value = '';
      }

      picker.addEventListener('change', apply);
      picker.addEventListener('input', apply);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
